# OAuth client from Google Cloud Console (Web application type).
# Authorised redirect URI must include: http://localhost:8090/api/auth/callback
GOOGLE_ADS_CLIENT_ID="your_client_id"
GOOGLE_ADS_CLIENT_SECRET="your_client_secret"

# Optional: only needed by cli_pipeline.py for headless/CI runs.
GOOGLE_ADS_REFRESH_TOKEN=""

# Optional: JEV decision engine. Defaults to http://localhost:8080
JEV_URL="http://localhost:8080"
